{
  "name": "workshift-tracker",
  "productName": "WorkShift Tracker",
  "version": "0.1.0",
  "description": "Personal Windows work shift tracker built with Electron, React, and TypeScript.",
  "main": "out/main/main.js",
  "type": "module",
  "author": "WorkShift Tracker",
  "scripts": {
    "dev": "electron-vite dev",
    "electron:dev": "electron-vite dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json --noEmit && electron-vite build",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:zip": "npm run build && electron-builder --win zip",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@tabler/icons-react": "latest",
    "@vitejs/plugin-react": "^5.1.2",
    "date-fns": "latest",
    "electron-vite": "^5.0.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "^7.3.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "latest",
    "electron-builder": "^26.8.1",
    "typescript": "latest",
    "vitest": "latest"
  },
  "build": {
    "appId": "com.workshift.tracker",
    "productName": "WorkShift Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
