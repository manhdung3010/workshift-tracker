{
  "name": "workshift-tracker",
  "version": "0.1.0",
  "description": "Personal Windows work shift tracker built with Electron, React, and TypeScript.",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "electron:dev": "electron-vite dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json --noEmit && electron-vite build",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@tabler/icons-react": "latest",
    "@vitejs/plugin-react": "^5.1.2",
    "date-fns": "latest",
    "electron": "latest",
    "electron-vite": "^5.0.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "^7.3.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
